{
    "name": "@theme-unify/root",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "dev": "pnpm --filter @theme-unify/playground dev",
        "generate": "pnpm --filter @theme-unify/playground generate",
        "changeset": "changeset",
        "version": "changeset version",
        "ci:publish": "changeset publish",
        "release": "pnpm --filter @jfitzsimmons2/theme-unify build && changeset publish",
        "release:dev": "pnpm --filter @jfitzsimmons2/theme-unify build && changeset publish --tag dev",
        "snapshot:dev": "changeset version --snapshot dev"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.6.0",
        "@changesets/cli": "^2.31.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "packageManager": "pnpm@11.0.0-rc.5+sha512.c469fb6aa13a99e57aec935cd7b86ff422701f4602ecac2231d3dc20910586ebfb6b50a7b455d0778ec22ae56912d8d8e88e9f9e0a03c0875a6a41783a94a1bd"
}