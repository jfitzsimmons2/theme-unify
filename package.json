{
    "name": "@theme-unify/root",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "dev": "pnpm --filter @theme-unify/playground dev",
        "generate": "pnpm --filter @theme-unify/playground generate",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm --filter @jfitzsimmons2/theme-unify build && changeset publish",
        "release:dev": "pnpm --filter @jfitzsimmons2/theme-unify build && changeset publish --tag dev",
        "snapshot:dev": "changeset version --snapshot dev"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.6.0",
        "@changesets/cli": "^2.31.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "packageManager": "pnpm@11.0.0-rc.3+sha512.9b6f50b42edeb873a131232f5951ae2ce5f743fa4bc121047996b386a0982fcb1b0fa7e2c075026320ab3eb399afa7d6e69ec684344e7d689186631c0bbc1b26"
}