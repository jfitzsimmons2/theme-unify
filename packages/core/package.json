{
  "name": "theme-unify",
  "version": "0.1.0",
  "type": "module",
  "description": "Compile a single token definition into PrimeVue 4 theme presets and UnoCSS theme configs",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "theme-unify": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsup": "^8.4.0",
    "typescript": "~5.9.3",
    "vitest": "^3.1.1"
  }
}
