{
    "name": "@theme-unify/playground",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "predev": "pnpm run generate:force",
        "dev": "vite",
        "prebuild": "pnpm run generate:force",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "generate": "theme-unify -c ./tokens.config.ts -o ./src/generated",
        "generate:force": "theme-unify -c ./tokens.config.ts -o ./src/generated --force"
    },
    "dependencies": {
        "@primeuix/themes": "^2.0.3",
        "primevue": "^4.5.4",
        "vue": "^3.5.30",
        "vue-router": "^5.0.4"
    },
    "devDependencies": {
        "@iconify-json/prime": "^1.2.4",
        "@types/node": "^24.12.0",
        "@unocss/preset-icons": "^66.6.7",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vue/tsconfig": "^0.9.0",
        "@jfitzsimmons2/theme-unify": "workspace:*",
        "typescript": "~5.9.3",
        "unocss": "^66.6.7",
        "vite": "^8.0.1",
        "vue-tsc": "^3.2.5"
    }
}